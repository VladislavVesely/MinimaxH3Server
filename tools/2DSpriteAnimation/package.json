{
  "name": "pi-2d-sprite-animation",
  "version": "0.1.0",
  "description": "Style-driven GPT Image/H3 animation to transparent sprites, general loop extraction and GIF previews",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["index.ts", "src", "processor.py", "sprite-defaults.json", "requirements.txt", "README.md", "NATIVE_VAE.md"],
  "pi": {"extensions": ["./index.ts"]},
  "engines": {"node": ">=22.19.0"},
  "scripts": {
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "check": "python3 processor.py check < tests/check.json"
  },
  "peerDependencies": {"@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-ai": "*", "typebox": "*"},
  "devDependencies": {"@earendil-works/pi-coding-agent": "1.3.0", "@earendil-works/pi-ai": "1.3.0", "@types/node": "^22.0.0", "tsx": "^4.20.0", "typebox": "^1.0.0", "typescript": "^5.9.0"}
}
